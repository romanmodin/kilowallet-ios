+
+// persistedBirthdayForRetry only reads persisted state; it never advances a
+// birthday, rewinds recovery progress, or changes wallet identity.
+func (w *Wallet) persistedBirthdayForRetry() (*waddrmgr.BlockStamp, error) {
+	store := &walletBirthdayStore{db: w.db, manager: w.Manager}
+	block, verified, err := store.BirthdayBlock()
+	if waddrmgr.IsError(err, waddrmgr.ErrBirthdayBlockNotSet) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !verified {
+		return nil, fmt.Errorf("persisted birthday block is unverified")
+	}
+	return &block, nil
+}
